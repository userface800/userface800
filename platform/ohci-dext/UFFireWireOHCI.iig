// UFFireWireOHCI.iig — userland 1394 OHCI controller driver (PCIDriverKit dext) interface.
//
// The transport layer for UserFace800 on Apple Silicon / Tahoe (no kernel IOFireWireFamily). This
// dext binds the Thunderbolt→FireWire adapter's OHCI PCI controller and exposes async read/write/
// lock + isochronous DMA to the userland driver. OHCI-0: claim + read Version/GUID. OHCI-1: reset,
// LPS/link enable, self-ID DMA buffer + interrupt → parse bus topology on reset.
//
// Reuse: the OHCI programming model is ported from Linux firewire ohci.c (GPL-2.0) + the 1394 OHCI
// 1.1 spec; the DriverKit plumbing (PCI claim, DMA, MSI) is new. REVIEW-ONLY until built in an
// Xcode DriverKit target (CLI iig mismatches the SDK — see README).
#ifndef UFFireWireOHCI_h
#define UFFireWireOHCI_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOInterruptDispatchSource.iig>
#include <DriverKit/IOUserClient.iig>

class UFFireWireOHCI: public IOService
{
public:
    virtual bool init() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual void free() override;

    // MSI interrupt handler (OHCI IntEvent). Dispatched via IOInterruptDispatchSource; the
    // CreateActionInterruptOccurred factory is generated by iig.
    virtual void InterruptOccurred(OSAction * action, uint64_t count, uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred);

    // Hand the daemon a connection to the transport (OHCI-2.5).
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    // Register transport ops the user client forwards to (target = the identified FF800 node).
    // `offset` is the full 48-bit FireWire address (uf::reg::*).
    virtual kern_return_t ReadQuadlet(uint64_t offset, uint32_t * value) LOCALONLY;
    virtual kern_return_t WriteQuadlet(uint64_t offset, uint32_t value) LOCALONLY;
    // Block write (e.g. the FF800's 3-quadlet conf block at 0xfc88f014, which the device expects as
    // one block transaction, not three quadlet writes).
    virtual kern_return_t WriteBlock(uint64_t offset, const uint32_t * quads, uint32_t count) LOCALONLY;

    // Isochronous receive (OHCI-3): capture `packets` packets from `channel` into the shared buffer.
    virtual kern_return_t IsoStart(uint32_t channel, uint32_t packets) LOCALONLY;
    virtual kern_return_t IsoPoll(uint32_t * received) LOCALONLY;
    virtual kern_return_t IsoStop() LOCALONLY;
    // Continuous capture (for the daemon): a wrapping DMA ring instead of a one-shot run.
    // IsoCompletedCount returns a monotonic total of packets the controller has written; the daemon
    // reads those slots from the mapped buffer, then IsoRelease(n) re-arms them. HARDWARE-GATED:
    // the wrapping ring + completion cursor have not run on real hardware yet.
    virtual kern_return_t IsoStartContinuous(uint32_t channel) LOCALONLY;
    virtual kern_return_t IsoCompletedCount(uint64_t * total) LOCALONLY;
    virtual kern_return_t IsoRelease(uint64_t upTo) LOCALONLY;
    // MIDI in: advertise a host receive address, drain received bytes, tear down. HARDWARE-GATED.
    virtual kern_return_t MidiInEnable(uint32_t highIndex) LOCALONLY;
    virtual kern_return_t MidiInPoll(uint8_t * out, uint32_t * outCount) LOCALONLY;
    virtual kern_return_t MidiInDisable() LOCALONLY;
    // Isochronous transmit: send (silent) packets so the device has an incoming stream — the FF800
    // will not start its own transmit stream into silence.
    virtual kern_return_t IsoTxStart(uint32_t channel, uint32_t fullPayloadBytes, uint32_t fullCount) LOCALONLY;
    virtual kern_return_t IsoTxStop() LOCALONLY;
    // Transmit pacing: IsoTxSent reports how many packets the controller has put on the wire, so the
    // daemon can fill the ring at a fixed lead ahead of the transmit head instead of free-running;
    // IsoTxRefill(n) hands back the slots it has rewritten. HARDWARE-GATED.
    virtual kern_return_t IsoTxSent(uint64_t * sent) LOCALONLY;
    virtual kern_return_t IsoTxRefill(uint64_t upTo) LOCALONLY;
    // Clock servo: resize one transmit slot's payload (the daemon sprinkles 7-frame packets among
    // the 6-frame ones so the long-term average matches the device's true rate). Only safe on a slot
    // behind the transmit head — the daemon calls it while filling, same as IsoTxRefill. HARDWARE-GATED.
    virtual kern_return_t IsoTxSetSlotBytes(uint32_t slot, uint32_t payloadBytes) LOCALONLY;
    // DIAGNOSTIC: log inbound async requests from the FF800 (host-node probe detection). HARDWARE-GATED.
    virtual kern_return_t DebugPollInbound() LOCALONLY;
    virtual kern_return_t CopyIsoBuffer(IOMemoryDescriptor ** memory) LOCALONLY;
    virtual kern_return_t CopyTxBuffer(IOMemoryDescriptor ** memory) LOCALONLY;
    virtual kern_return_t CopyStatusBuffer(IOMemoryDescriptor ** memory) LOCALONLY;

    // Interrupt-driven pump: the daemon subscribes once (async external method) and the isochronous
    // receive completion interrupt then wakes it, instead of it polling on a 1 ms timer. The user
    // client hands us both itself and the client's completion action, because AsyncCompletion() is
    // an IOUserClient method and the interrupt fires on the driver.
    virtual kern_return_t SetIsoWake(IOUserClient * client, OSAction * action) LOCALONLY;

    // Read the OHCI isochronous cycle timer (the bus clock) — the ISOCH_QUERY_CYCLE_TIME equivalent.
    virtual kern_return_t ReadCycleTimer(uint32_t * value) LOCALONLY;
};

#endif /* UFFireWireOHCI_h */
