<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.userface800.UFLoader.UFFireWireOHCI</string>
    <key>CFBundleName</key>
    <string>UFFireWireOHCI</string>
    <key>CFBundleVersion</key>
    <string>0.0.1</string>
