    <string>Userland 1394 OHCI driver for the RME Fireface 800 (UserFace800).</string>
    <key>OSMinimumDriverKitVersion</key>
    <string>24.0</string>
    <key>IOKitPersonalities</key>
    <dict>
        <key>UFFireWireOHCI</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>com.userface800.UFLoader.UFFireWireOHCI</string>
            <key>IOClass</key>
            <string>IOUserService</string>
            <key>IOUserClass</key>
            <string>UFFireWireOHCI</string>
            <key>IOProviderClass</key>
            <string>IOPCIDevice</string>
            <!-- Match any 1394 OHCI controller (base 0x0c / sub 0x00 / prog-if 0x10),
