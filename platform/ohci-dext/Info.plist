            <key>IOPCIClassMatch</key>
            <string>0x0c001000&amp;0xffffff00</string>
            <!-- Required to bind a Thunderbolt-tunneled PCI device. -->
            <key>IOPCITunnelCompatible</key>
            <true/>
            <key>IOUserServerName</key>
            <string>com.userface800.UFLoader.UFFireWireOHCI</string>
            <key>IOMatchCategory</key>
            <string>com.userface800.UFLoader.UFFireWireOHCI</string>
            <key>UserClientProperties</key>
            <dict>
                <key>IOClass</key>
                <string>IOUserUserClient</string>
                <key>IOUserClass</key>
                <string>UFFireWireOHCIUserClient</string>
            </dict>
        </dict>
    </dict>
